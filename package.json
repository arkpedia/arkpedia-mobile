{
  "name": "arkpedia-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Android and iOS shells for the live Arkpedia website",
  "scripts": {
    "sync": "cap sync",
    "sync:android": "cap sync android",
    "sync:ios": "cap sync ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "android:debug": "npm run sync:android && cd android && ./gradlew assembleDebug",
    "check": "node scripts/check-config.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  },
  "engines": { "node": ">=24.0.0" }
}
